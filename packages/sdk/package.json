{
  "name": "@vaultkit/sdk",
  "version": "0.1.0",
  "description": "Framework-free, viem-based SDK for VaultKit token vesting.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": ["dist"],
  "keywords": ["vesting", "token", "escrow", "viem", "ethereum", "base"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "codegen": "tsx scripts/codegen.ts",
    "clean": "rimraf dist .turbo"
  },
  "dependencies": {
    "viem": "^2.21.40"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "@vaultkit/config": "workspace:*",
    "rimraf": "^6.0.1",
    "tsup": "^8.3.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.3"
  }
}
