{
  "name": "@vaultkit/react",
  "version": "0.1.0",
  "description": "React hooks for VaultKit, layered on @vaultkit/sdk and wagmi.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": ["dist"],
  "keywords": ["vesting", "react", "wagmi", "viem", "hooks"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "node --eval \"process.exit(0)\"",
    "clean": "rimraf dist .turbo"
  },
  "dependencies": {
    "@vaultkit/sdk": "workspace:*"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "viem": "^2.21.0",
    "wagmi": "^2.12.0"
  },
  "devDependencies": {
    "@tanstack/react-query": "^5.59.16",
    "@types/react": "^18.3.11",
    "@vaultkit/config": "workspace:*",
    "react": "^18.3.1",
    "rimraf": "^6.0.1",
    "tsup": "^8.3.0",
    "typescript": "^5.6.3",
    "viem": "^2.21.40",
    "wagmi": "^2.12.17"
  }
}
