{
  "name": "vaultkit",
  "version": "0.1.0",
  "private": true,
  "description": "Token vesting and escrow infrastructure — isolated vesting wallets, verifiable cliff math, and a typed SDK.",
  "license": "MIT",
  "packageManager": "pnpm@11.23.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "turbo run clean"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "prettier-plugin-solidity": "^1.4.1",
    "turbo": "^2.1.3",
    "typescript": "^5.6.3"
  }
}
